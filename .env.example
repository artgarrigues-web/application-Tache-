# Copie ce fichier en ".env.local" et remplis les deux valeurs.
# Où les trouver : Supabase → ton projet → bouton "Connect" (ou Project Settings → API Keys).
# ".env.local" est ignoré par Git : il ne sera jamais envoyé sur GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
